import Mathlib


lemma finite_of_nilpotent_fg_order {G: Type*} [Group G] [Group.FG G] [Group.IsNilpotent G] (m: ℕ) (hg: ∀ g : G, orderOf g = m): Finite G := by
  -- By definition of exponent, $m$ is the order of $G$, so $G$ is finite.
  have h_finite : ∀ g : G, (orderOf g) = m := by
    exact hg
  have h_finite_group : Finite G := by
    have h_exp : ∀ g : G, (orderOf g) ∣ m := by
      aesop
    have := h_finite 1;aesop;
    exact Set.finite_univ_iff.mp ( Set.Finite.subset ( Set.finite_singleton 1 ) fun x _ => h_finite x );
  exact h_finite_group
